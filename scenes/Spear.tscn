extends Node2D

# Reusable spear projectile for the dissection attack phase.
# It can be spawned from multiple positions and travels toward the soul.

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D

var velocity: Vector2 = Vector2.ZERO
var bounds: Rect2 = Rect2(Vector2(500, 180), Vector2(280, 200))
var active: bool = true
var lifetime: float = 2.4

func _ready() -> void:
	if sprite == null:
		var fallback := ColorRect.new()
		fallback.size = Vector2(16, 36)
		fallback.color = Color(0.69, 0.84, 1.0, 1.0)
		add_child(fallback)
		return
	var frames := _build_animation_frames()
	if frames:
		sprite.sprite_frames = frames
		sprite.animation = "spear"
		sprite.autoplay = "spear"
		sprite.play("spear")
	else:
		sprite.modulate = Color(0.69, 0.84, 1.0, 1.0)
		var rect := ColorRect.new()
		rect.size = Vector2(16, 36)
		rect.color = Color(0.69, 0.84, 1.0, 1.0)
		sprite.add_child(rect)

func _process(delta: float) -> void:
	if not active:
		return
	position += velocity * delta
	lifetime -= delta
	if lifetime <= 0.0:
		queue_free()
		return
	var min_x := bounds.position.x
	var max_x := bounds.position.x + bounds.size.x
	var min_y := bounds.position.y
	var max_y := bounds.position.y + bounds.size.y
	if position.x <= min_x or position.x >= max_x:
		velocity.x *= -1.0
		position.x = clamp(position.x, min_x, max_x)
	if position.y <= min_y or position.y >= max_y:
		velocity.y *= -1.0
		position.y = clamp(position.y, min_y, max_y)
	if sprite:
		sprite.rotation = velocity.angle() + PI / 2.0

func set_velocity(value: Vector2) -> void:
	velocity = value

func set_bounds(value: Rect2) -> void:
	bounds = value

func set_lifetime(value: float) -> void:
	lifetime = value

func _build_animation_frames() -> SpriteFrames:
	var frames := SpriteFrames.new()
	frames.add_animation("spear")
	frames.set_animation_loop("spear", false)
	frames.set_animation_speed("spear", 17.0)
	var matches: Array[Dictionary] = []
	for path in _all_png_paths("res://"):
		var base := path.get_file().get_basename().to_lower()
		if not base.begins_with("spear"):
			continue
		var number := _trailing_number(base)
		if number >= 0:
			matches.append({"number": number, "path": path})
	matches.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
		return a["number"] < b["number"]
	)
	for item in matches:
		var texture := load(item["path"]) as Texture2D
		if texture:
			frames.add_frame("spear", texture)
	if frames.get_frame_count("spear") > 0:
		return frames
	return null

func _all_png_paths(directory: String) -> Array[String]:
	var result: Array[String] = []
	var dir := DirAccess.open(directory)
	if not dir:
		return result
	dir.list_dir_begin()
	var file_name := dir.get_next()
	while file_name != "":
		if file_name.begins_with("."):
			file_name = dir.get_next()
			continue
		var path := directory.path_join(file_name)
		if dir.current_is_dir():
			result.append_array(_all_png_paths(path))
		elif file_name.to_lower().ends_with(".png"):
			result.append(path)
		file_name = dir.get_next()
	dir.list_dir_end()
	return result

func _trailing_number(text: String) -> int:
	var regex := RegEx.new()
	regex.compile("(\\d+)$")
	var result := regex.search(text)
	return int(result.get_string(1)) if result else -1
