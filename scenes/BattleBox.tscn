extends Node

# Battle flow controller for the boss encounter.
# Handles the normal battle state, enemy-turn box activation, and Soul movement.

var battle_scene: Node2D
var parralexs_actor: AnimatedSprite2D
var knight_actor: AnimatedSprite2D
var battle_box: Node2D
var soul: Node2D
var ui_root: PanelContainer

var phase: String = "normal"
var phase_timer: float = 0.0
var attack_delay: float = 0.0
var battle_box_opened: bool = false
var last_move: Vector2 = Vector2.ZERO

func configure(scene: Node2D, parralexs: AnimatedSprite2D, knight: AnimatedSprite2D, ui: PanelContainer, box: Node2D, soul_node: Node2D) -> void:
	battle_scene = scene
	parralexs_actor = parralexs
	knight_actor = knight
	ui_root = ui
	battle_box = box
	soul = soul_node
	if ui_root:
		ui_root.visible = true

func begin_normal_battle() -> void:
	phase = "normal"
	phase_timer = 0.0
	_set_battle_box_visible(false)
	_set_soul_visible(false)
	if ui_root:
		ui_root.visible = true

func begin_enemy_turn() -> void:
	phase = "enemy_turn"
	phase_timer = 0.0
	attack_delay = 0.75
	_set_battle_box_visible(true)
	_set_soul_visible(true)
	if knight_actor:
		knight_actor.play("idle")
	if soul:
		soul.position = Vector2(620, 300)
		last_move = Vector2.ZERO

func end_enemy_turn() -> void:
	phase = "normal"
	phase_timer = 0.0
	_set_battle_box_visible(false)
	_set_soul_visible(false)
	if ui_root:
		ui_root.visible = true

func _process(delta: float) -> void:
	if phase == "normal":
		_handle_normal_phase(delta)
		return
	if phase == "enemy_turn":
		_handle_enemy_turn(delta)
		return
	if phase == "attack":
		_handle_attack_phase(delta)

func _handle_normal_phase(_delta: float) -> void:
	if ui_root:
		ui_root.visible = true
	if Input.is_action_just_pressed("ui_accept"):
		begin_enemy_turn()

func _handle_enemy_turn(delta: float) -> void:
	phase_timer += delta
	if soul:
		_move_soul(delta)
	if phase_timer >= attack_delay:
		phase = "attack"
		phase_timer = 0.0
		_start_simple_enemy_attack()

func _handle_attack_phase(delta: float) -> void:
	phase_timer += delta
	if phase_timer >= 1.1:
		_end_attack_and_return()

func _start_simple_enemy_attack() -> void:
	# A basic enemy-turn attack that uses the battle box and the Soul.
	# Later this can be expanded into Spin Blade / Spear / Dissection scripts.
	if soul:
		soul.modulate = Color(1.0, 0.7, 0.7, 1.0)

func _end_attack_and_return() -> void:
	if soul:
		soul.modulate = Color(1.0, 1.0, 1.0, 1.0)
	end_enemy_turn()

func _move_soul(delta: float) -> void:
	if not soul:
		return
	var input_vector := Vector2.ZERO
	if Input.is_key_pressed(KEY_W) or Input.is_key_pressed(KEY_UP):
		input_vector.y -= 1.0
	if Input.is_key_pressed(KEY_S) or Input.is_key_pressed(KEY_DOWN):
		input_vector.y += 1.0
	if Input.is_key_pressed(KEY_A) or Input.is_key_pressed(KEY_LEFT):
		input_vector.x -= 1.0
	if Input.is_key_pressed(KEY_D) or Input.is_key_pressed(KEY_RIGHT):
		input_vector.x += 1.0
	if input_vector.length() > 0.0:
		input_vector = input_vector.normalized()
		last_move = input_vector

	var speed := 220.0
	var next_position := soul.position + input_vector * speed * delta
	var box_rect := Rect2(Vector2(500, 180), Vector2(280, 200))
	next_position.x = clamp(next_position.x, box_rect.position.x + 12, box_rect.position.x + box_rect.size.x - 12)
	next_position.y = clamp(next_position.y, box_rect.position.y + 12, box_rect.position.y + box_rect.size.y - 12)
	soul.position = next_position

func _set_battle_box_visible(visible: bool) -> void:
	if battle_box:
		battle_box.visible = visible
	if battle_box:
		for child in battle_box.get_children():
			if child is CanvasItem:
				child.visible = visible

func _set_soul_visible(visible: bool) -> void:
	if soul:
		soul.visible = visible
